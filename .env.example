# =============================================================
# EDITAL ANALYZER - Exemplo de variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores conforme
# necessário. NUNCA commite o `.env` real.
# =============================================================

# Nível de log (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# === Configurações da API ===
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS - origens permitidas, separadas por vírgula
# Use "*" para liberar todas (apenas desenvolvimento).
CORS_ORIGINS=*

# === Caminhos (opcionais - já têm defaults razoáveis no código) ===
# DATA_DIR=./data
# OUTPUTS_DIR=./outputs
# LOGS_DIR=./logs

# === Configurações de NLP (futuras integrações) ===
# Se quiser usar um modelo spaCy diferente
SPACY_MODEL=pt_core_news_sm
